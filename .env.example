# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # server-only — NUNCA al cliente
DATABASE_URL=postgresql://postgres:...@host:6543/postgres   # pooled (runtime)
DIRECT_URL=postgresql://postgres:...@host:5432/postgres     # no pooled (migraciones)

# === Google OAuth (configurado en Supabase Auth provider) ===
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# === Cifrado de tokens Calendar (SEC-06) — 32 bytes base64 ===
TOKEN_ENC_KEY=base64:CHANGE_ME_openssl_rand_base64_32

# === Cron ===
CRON_SECRET=CHANGE_ME_openssl_rand_base64_32

# === Observabilidad ===
SENTRY_DSN=
